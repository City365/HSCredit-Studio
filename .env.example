# 开发环境配置（请勿提交真实值）

# ===== 后端 =====
BACKEND_ENV=development
BACKEND_DEBUG=true
BACKEND_SECRET_KEY=change-me-in-production-min-32-chars
BACKEND_LOG_LEVEL=DEBUG

# 数据库
DATABASE_URL=postgresql+asyncpg://hscredit:hscredit@localhost:5432/hscredit
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CELERY_URL=redis://localhost:6379/1

# MinIO / S3
S3_ENDPOINT=http://localhost:9001
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET_PREFIX=hscredit-dev
S3_REGION=us-east-1

# JWT
JWT_SECRET_KEY=change-me-min-32-chars-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 限流
RATE_LIMIT_PER_TENANT=100
RATE_LIMIT_WINDOW_SECONDS=60

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 可观测性
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=hscredit-studio-dev

# ===== 前端 =====
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
VITE_DEFAULT_LOCALE=zh-CN

# ===== 沙箱（Phase 3）=====
SANDBOX_IMAGE=hscredit-sandbox:latest
SANDBOX_TIMEOUT_SEC=300
SANDBOX_MEMORY_LIMIT=4g
SANDBOX_CPU_LIMIT=2

# ===== 第三方集成（可选）=====
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?access_token=xxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@hscredit.com
# SMTP_PASSWORD=xxx
